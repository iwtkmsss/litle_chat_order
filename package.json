{
  "name": "litle-chat-order",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c magenta,cyan \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:public": "node scripts/public-runner.mjs dev",
    "preview:public": "node scripts/public-runner.mjs preview",
    "build:public": "node scripts/public-runner.mjs build",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "create-admin": "npm run create-admin -w server --",
    "check:document-mapping": "npm run check:document-mapping -w server",
    "check:template-placeholders": "npm run check:template-placeholders -w server",
    "check:template-generation": "npm run check:template-generation -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
