{
  "name": "litle-chat-order",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c magenta,cyan \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "create-manager": "npm run create-manager -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
